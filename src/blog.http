@server = http://localhost:3000

# 게시글 조회
GET {{server}}/blog


# 게시물 생성
POST {{server}}/blog
Content-Type: application/json
{
  "title": "안녕하세요",
  "content": "처음 인사 드립니다",
  "name": "이름"
}

# 특정글 조회
POST {{server}}/blog/<게시글ID>

# 특정글 삭제
DELETE {{server}}/blog/<게시글ID>

# 게시글 수정
PUT {{server}}/blog/<게시글ID>
Content-Type: application/json
{
  "title": "타이틀 수정",
  "content": "본문수정",
  "name": "james.Dean"
}